{
  "name": "@jigging/sley",
  "version": "0.0.1",
  "type": "module",
  "types": "./dist/sley.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/sley.d.ts",
        "require": "./dist/sley.d.cts"
      },
      "import": "./dist/sley.js",
      "require": "./dist/sley.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://sley.jig.md",
  "repository": "github:jigmd/sley",
  "bugs": {
    "url": "https://github.com/jigmd/sley/issues"
  },
  "description": "Structured graph runtime for Python and TypeScript.",
  "keywords": [
    "AI",
    "workflow",
    "graph",
    "runtime",
    "LLM"
  ],
  "license": "MPL-2.0",
  "author": {
    "name": "Victor Duarte",
    "url": "https://github.com/zvictor"
  },
  "scripts": {
    "build": "tsup && cp ../README.md ./README.md",
    "prepack": "pnpm run build",
    "test": "NODE_OPTIONS='--experimental-vm-modules --import=tsx' node --test tests/*.test.ts",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@std/assert": "npm:@jsr/std__assert@1.0.19",
    "@types/node": "24.13.3",
    "p-limit": "7.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "access": "public"
  }
}
