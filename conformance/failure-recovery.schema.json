{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caskada.dev/conformance/v3-failure-recovery.schema.json",
  "title": "Caskada v3 failure and recovery fixture collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixtures"],
  "properties": {
    "schema_version": { "const": 1 },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "requirements", "program", "expect"],
      "properties": {
        "id": { "type": "string", "pattern": "^F[0-9]{2}_[a-z0-9_]+$" },
        "purpose": { "type": "string", "minLength": 1 },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "program": { "$ref": "#/$defs/program" },
        "expect": { "type": "object", "minProperties": 1 }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology", "handler", "retry_max_attempts", "node_recovery", "flow_recovery"],
      "properties": {
        "topology": { "enum": ["root_node", "node_after_source", "nested_flow", "combine"] },
        "handler": { "enum": ["fail", "fail_once_then_end", "end"] },
        "retry_max_attempts": { "type": "integer", "minimum": 1 },
        "node_recovery": { "enum": ["none", "pass", "end", "throw"] },
        "flow_recovery": { "enum": ["none", "pass", "end", "throw"] },
        "input": {},
        "output": {}
      }
    }
  }
}
