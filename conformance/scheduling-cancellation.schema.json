{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skada.ai/caskada/conformance/scheduling-cancellation.schema.json",
  "title": "Caskada v3 scheduling and cancellation fixture collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixtures"],
  "properties": {
    "schema_version": { "const": 1 },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "requirements", "program", "expect"],
      "properties": {
        "id": { "type": "string", "pattern": "^[QK][0-9]{2}_[a-z0-9_]+$" },
        "purpose": { "type": "string", "minLength": 1 },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "program": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenario"],
          "properties": {
            "scenario": {
              "enum": [
                "auto_width",
                "nested_auto_width",
                "global_ceiling",
                "retry_ready_priority",
                "fair_scope_rotation",
                "sibling_signal_before_recovery",
                "cancel_before_admission",
                "cancel_after_buffer",
                "post_signal_suppression",
                "prior_terminal_ready_discard",
                "cancel_retry_delay",
                "cancel_node_recovery",
                "cancel_flow_recovery"
              ]
            },
            "width": { "type": "integer", "minimum": 1 },
            "max_concurrency": { "type": "integer", "minimum": 1 }
          }
        },
        "expect": { "type": "object" }
      }
    }
  }
}
