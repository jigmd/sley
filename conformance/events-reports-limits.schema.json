{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skada.ai/caskada/conformance/events-reports-limits.schema.json",
  "title": "Caskada v3 events, reports, observers, and limits fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixtures"],
  "properties": {
    "schema_version": { "const": 1 },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "requirements", "program", "expect"],
      "properties": {
        "id": { "type": "string", "pattern": "^[ERL][0-9]{2}_[a-z0-9_]+$" },
        "purpose": { "type": "string", "minLength": 1 },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "program": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenario"],
          "properties": {
            "scenario": {
              "enum": [
                "successful_trace",
                "observer_skip",
                "observer_throw",
                "report_presence",
                "report_reentrant",
                "report_overflow",
                "transition_overflow",
                "capacity_priority",
                "depth_limit",
                "attempt_limit"
              ]
            }
          }
        },
        "expect": { "type": "object" }
      }
    }
  }
}
